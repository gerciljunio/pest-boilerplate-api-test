{
    "name": "gerciljunio/pest-boilerplate-api-test",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Gercil",
            "email": "gerciljunio@gmail.com"
        }
    ],
    "require-dev": {
        "pestphp/pest": "^4.1",
        "vlucas/phpdotenv": "^5.6",
        "allure-framework/allure-phpunit": "^3.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require": {
        "guzzlehttp/guzzle": "^7.10",
        "illuminate/http": "^12.34",
        "illuminate/support": "^12.34"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/Support/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest || true",
        "test:allure": [
            "echo \"\\033[0;32mIniciando geração de relatório com Allure...\\033[0m\"",
            "allure generate build/allure-results --clean -o build/allure-report",
            "echo \"\\033[0;32mAbrindo relatório com Allure...\\033[0m\"",
            "allure open build/allure-report"
        ]
    }
}
