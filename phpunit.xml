<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Test Suite">
            <directory suffix="Test.php">./tests</directory>
        </testsuite>
    </testsuites>

    <extensions>
        <bootstrap class="Qameta\Allure\PHPUnit\AllureExtension">
          <!-- https://github.com/allure-framework/allure-phpunit?tab=readme-ov-file#installation--usage -->
          <!-- Path to config file (default is config/allure.config.php) -->
          <!-- <parameter name="config" value="config/allure.config.php" /> -->
        </bootstrap>
    </extensions>

    <php>
        <env name="ALLURE_RESULTS_DIR" value="build/allure-results"/>
    </php>

    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
